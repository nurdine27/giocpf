{
  "name": "gio-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib next.config.ts postcss.config.mjs eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,cts,css,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,cts,css,json,md,yml}\""
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "@eslint/eslintrc": "^3.2.0",
    "prettier": "^3.9.10"
  }
}
