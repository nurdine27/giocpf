# RENDER — backend production
NODE_ENV=production
APP_URL=https://TEU-DOMINIO-VERCEL.vercel.app

# NEON — copia as URLs em Neon Console > projecto > Connect.
# DATABASE_URL: pooled; o hostname contém -pooler.
# DIRECT_URL: direct/unpooled; usado pelo Prisma nas migrations.
# Mantém sslmode=require nas URLs copiadas do Neon.
DATABASE_URL=
DIRECT_URL=

# CLOUDINARY — necessário para uploads de imagens.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RESEND — necessário para envio de email.
# Usa uma API key de produção e um domínio validado no Resend.
RESEND_API_KEY=
MAIL_FROM="GIO CPF <noreply@TEU-DOMINIO-VALIDADO>"
MAIL_REPLY_TO=
INSTITUTIONAL_EMAIL=
