DATABASE_URL="postgresql://gio:gio_local_dev@127.0.0.1:5433/gio?schema=public"
POSTGRES_PASSWORD="gio_local_dev"
API_PORT=4000
# La API é publicada em /api/v1 pelo backend.
APP_URL="http://localhost:3000"

# Cloudinary (Dashboard > Settings > Access Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- E-mail -------------------------------------------------------------
# Resend (recomendado): https://resend.com
#  1. Domains > Add domain e adicione os registos DNS (SPF/DKIM) até ficar "Verified".
#  2. API Keys > Create API key (permissão "Sending access").
#  3. MAIL_FROM tem de usar o domínio verificado. Sem domínio, para testes, use
#     "GIO CPF <onboarding@resend.dev>" (só entrega no e-mail da conta Resend).
RESEND_API_KEY=
MAIL_FROM="GIO CPF <noreply@seudominio.co.mz>"
# Opcional: endereço para onde vão as respostas aos e-mails automáticos.
MAIL_REPLY_TO=
# Caixa que recebe avisos de novas mensagens e inscrições
# (a definida em Admin > Configurações tem prioridade).
INSTITUTIONAL_EMAIL=giocentrodeformacao@gmail.com

# Alternativa: SMTP (usado apenas quando RESEND_API_KEY está vazio).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
