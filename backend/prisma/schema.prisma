generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RegistrationStatus {
  PENDENTE
  EM_ANALISE
  ACEITE
  RECUSADA
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  permissions  String[] @default([])
  isSuperAdmin Boolean  @default(false)
  active       Boolean  @default(true)
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  displayName  String   @default("")
  phone        String?
  profilePhotoUrl String?
  profilePhotoPublicId String?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
  news         News[]
  events       Event[]
  albums       Album[]
  passwordOtps AdminPasswordOtp[]
  messages     ContactMessage[]
  replies      MessageReply[]
  settingsUpdates InstitutionSetting[]
}

model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  permissions String[]    @default([])
  isSystem    Boolean     @default(false)
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  news      News[]
  createdAt DateTime @default(now())
}

model News {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  subtitle    String        @default("")
  summary     String        @default("")
  content     String
  coverUrl    String?
  coverPublicId String?
  published   Boolean       @default(false)
  featured    Boolean       @default(false)
  publishedAt DateTime?
  authorId    String
  categoryId  String?
  author      AdminUser     @relation(fields: [authorId], references: [id])
  category    NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  photos      Photo[]
  albums      Album[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([published, publishedAt])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  location    String   @default("")
  coverUrl    String?
  coverPublicId String?
  startsAt    DateTime
  endsAt      DateTime?
  status      String   @default("AGENDADO")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  authorId    String
  author      AdminUser @relation(fields: [authorId], references: [id])
  photos      Photo[]
  albums      Album[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([published, startsAt])
}

model Album {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  coverUrl    String?
  coverPublicId String?
  published   Boolean  @default(false)
  authorId    String
  newsId      String?
  eventId     String?
  author      AdminUser @relation(fields: [authorId], references: [id])
  news        News?    @relation(fields: [newsId], references: [id], onDelete: SetNull)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  publicId  String?
  alt       String   @default("")
  sortOrder Int      @default(0)
  newsId    String?
  eventId   String?
  albumId   String?
  news      News?    @relation(fields: [newsId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  album     Album?   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([albumId, sortOrder])
}

model AdminSession {
  id        String    @id
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AdminPasswordOtp {
  id        String   @id @default(cuid())
  adminId   String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  @@index([adminId, expiresAt])
}

model Course {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  area           String
  description    String         @default("")
  imageUrl       String?
  imagePublicId  String?
  duration       String?
  requirements   String?
  published      Boolean        @default(false)
  enrollmentOpen Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registrations  Registration[]
  classes        ClassGroup[]

  @@index([area, published])
}

model Registration {
  id            String             @id @default(cuid())
  reference     String             @unique
  submissionKey String             @unique
  name          String
  phone         String
  email         String?
  age           Int?
  birthDate     DateTime?
  gender        String?
  documentType  String?
  documentNumber String?
  educationLevel String?
  occupation    String?
  address       String?
  emergencyName  String?
  emergencyPhone String?
  referralSource String?
  campusId      String?
  classId       String?
  waitlisted    Boolean            @default(false)
  province      String
  district      String
  area          String
  courseName    String
  courseId      String?
  message       String?
  status        RegistrationStatus @default(PENDENTE)
  consentedAt   DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  course        Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  campus        Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classGroup    ClassGroup?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  notes         RegistrationNote[]

  @@index([status, createdAt])
  @@index([classId, status])
  @@index([courseId, createdAt])
  @@index([name])
}

/// Physical location where classes take place (e.g. Nacala, Cidade de Nampula).
model Campus {
  id            String         @id @default(cuid())
  name          String         @unique
  city          String
  address       String         @default("")
  active        Boolean        @default(true)
  classes       ClassGroup[]
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Academic period: when lessons start and end. One period serves one or more classes.
model Period {
  id                 String       @id @default(cuid())
  name               String
  startsAt           DateTime
  endsAt             DateTime?
  enrollmentClosesAt DateTime?
  active             Boolean      @default(true)
  classes            ClassGroup[]
  extensions         PeriodExtension[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([active, startsAt])
}

/// History of every time a period's end date or enrollment deadline was pushed back.
model PeriodExtension {
  id                         String    @id @default(cuid())
  periodId                   String
  adminId                    String?
  reason                     String    @default("")
  previousEndsAt             DateTime?
  newEndsAt                  DateTime?
  previousEnrollmentClosesAt DateTime?
  newEnrollmentClosesAt      DateTime?
  createdAt                  DateTime  @default(now())
  period                     Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, createdAt])
}

/// A class ("turma") of a course, at a campus, within a period, with a limited number of seats.
model ClassGroup {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  courseId      String
  campusId      String
  periodId      String
  capacity      Int
  shift         String         @default("MANHA")
  schedule      String         @default("")
  status        String         @default("ABERTA")
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  campus        Campus         @relation(fields: [campusId], references: [id], onDelete: Restrict)
  period        Period         @relation(fields: [periodId], references: [id], onDelete: Restrict)
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([courseId, campusId, status])
  @@index([periodId])
}

model RegistrationNote {
  id             String       @id @default(cuid())
  registrationId String
  adminId        String
  body           String
  createdAt      DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  targetId  String
  createdAt DateTime @default(now())
  module    String   @default("system")
  metadata  Json?

  @@index([adminId, createdAt])
}

enum ContactMessageStatus {
  NAO_LIDA
  LIDA
  EM_TRATAMENTO
  RESPONDIDA
  ARQUIVADA
}
model ContactMessage {
  id        String @id @default(cuid())
  name      String
  email     String
  subject   String
  category  String
  body      String
  status    ContactMessageStatus @default(NAO_LIDA)
  assignedAdminId String?
  assignedAdmin AdminUser? @relation(fields:[assignedAdminId],references:[id],onDelete:SetNull)
  replies   MessageReply[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([category, createdAt])
}
model MessageReply {
  id String @id @default(cuid())
  messageId String
  adminId String
  body String
  createdAt DateTime @default(now())
  message ContactMessage @relation(fields:[messageId],references:[id],onDelete:Cascade)
  admin AdminUser @relation(fields:[adminId],references:[id],onDelete:Restrict)
  @@index([messageId,createdAt])
}
model InstitutionSetting {
  key String @id
  value Json
  updatedById String?
  updatedBy AdminUser? @relation(fields:[updatedById],references:[id],onDelete:SetNull)
  updatedAt DateTime @updatedAt
}
